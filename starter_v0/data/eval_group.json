{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Team-authored extension cases for the IT Helpdesk Agent: 5 single-turn + 5 multi-turn, exercising tools/params not covered by the fixed base 30.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_printing_status",
      "phase": "B",
      "suite": "group",
      "case_suite": "group",
      "is_multiturn": false,
      "metadata": {
        "skill": "route_printing_service",
        "difficulty": "easy",
        "what_it_tests": "Dịch vụ printing (chưa test ở bộ base) phải đi vào check_service_status với đúng environment."
      },
      "input": "Dịch vụ in ấn (printing) trên production có đang hoạt động không?",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "printing",
              "environment": "production"
            }
          }
        ]
      },
      "failure_type": "wrong_tool"
    },
    {
