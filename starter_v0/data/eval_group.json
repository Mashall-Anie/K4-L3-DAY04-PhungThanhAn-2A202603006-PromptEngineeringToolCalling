      },
      "input": "Tìm chính sách về kiểm soát truy cập (access control) cho nhân viên mới vào công ty.",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "policy_area": "access_control"
            }
          }
        ]
      },
      "failure_type": "wrong_tool"
    },
