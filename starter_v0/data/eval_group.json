      "case_suite": "group",
      "is_multiturn": false,
      "metadata": {
        "skill": "confirm_write_sso",
        "difficulty": "medium",
        "what_it_tests": "Write action (create_ticket) cho service SSO vẫn phải dừng ở clarify(yes_no) trước, không tự tạo."
      },
      "input": "Tạo ticket mức critical báo SSO bị lỗi đăng nhập cho toàn công ty.",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "failure_type": "wrong_boundary"
    },
    {
